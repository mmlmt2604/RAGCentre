{
 "description": "Shared by the backend and the UI mock. schemas: the options_schema of the four shims at 0.3.0 (docling, mineru, paddleocr, surya) and small ones for keywords they do not use yet. cases: a route's options and the problems the backend (ragcentre.pipeline.graph.option_problems, the reference) reports, in its order. unmirrored: violations the backend words with jsonschema's own text; the mock accepts them. See tests/test_parser_options_schema.py and ui/src/mocks/mock.test.ts.",
 "schemas": {
  "docling": {
   "additionalProperties": false,
   "description": "Unknown keys are rejected and types are strict, so ``\"false\"`` is not a boolean.",
   "properties": {
    "pipeline": {
     "default": "standard",
     "description": "standard is Docling's layout, OCR and table pipeline; vlm has a vision-language model read each page (slow, needs a model download). The vlm pipeline takes none of: ocr, tables, table_mode, ocr_engine, languages, force_full_page_ocr, formulas, code.",
     "enum": [
      "standard",
      "vlm"
     ],
     "title": "Pipeline",
     "type": "string"
    },
    "vlm_model": {
     "default": "granite_docling",
     "description": "The model of the vlm pipeline (a Docling preset). Only with pipeline vlm.",
     "enum": [
      "granite_docling",
      "smoldocling"
     ],
     "title": "Vlm Model",
     "type": "string"
    },
    "ocr": {
     "default": true,
     "description": "Run OCR on scanned pages and images.",
     "title": "Ocr",
     "type": "boolean"
    },
    "include_page_images": {
     "default": false,
     "description": "Return each rendered page as a base64 PNG.",
     "title": "Include Page Images",
     "type": "boolean"
    },
    "page_range": {
     "anyOf": [
      {
       "items": {
        "minimum": 1,
        "type": "integer"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Parse only these pages: [first, last], 1-based and inclusive. Default: the whole file.",
     "title": "Page Range"
    },
    "languages": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "OCR languages, in the OCR engine's own codes (en for EasyOCR, eng for Tesseract). Default: the engine's own default.",
     "title": "Languages"
    },
    "tables": {
     "default": true,
     "description": "Recognise table structure.",
     "title": "Tables",
     "type": "boolean"
    },
    "table_mode": {
     "default": "accurate",
     "description": "Table recognition model: fast or accurate.",
     "enum": [
      "fast",
      "accurate"
     ],
     "title": "Table Mode",
     "type": "string"
    },
    "ocr_engine": {
     "default": "auto",
     "description": "OCR engine. auto picks the first installed of the engines Docling tries; tesseract is tesserocr (Python bindings) and tesseract_cli runs the tesseract program.",
     "enum": [
      "auto",
      "easyocr",
      "rapidocr",
      "tesseract",
      "tesseract_cli"
     ],
     "title": "Ocr Engine",
     "type": "string"
    },
    "force_full_page_ocr": {
     "default": false,
     "description": "OCR the whole page, even where there is a text layer (Docling OcrMode full_page).",
     "title": "Force Full Page Ocr",
     "type": "boolean"
    },
    "formulas": {
     "default": false,
     "description": "Recognise formulas and write them as LaTeX.",
     "title": "Formulas",
     "type": "boolean"
    },
    "code": {
     "default": false,
     "description": "Recognise code blocks and their language.",
     "title": "Code",
     "type": "boolean"
    },
    "picture_classification": {
     "default": false,
     "description": "Classify pictures (chart, photo, logo, ...); the class is kept in block metadata.",
     "title": "Picture Classification",
     "type": "boolean"
    },
    "picture_description": {
     "default": false,
     "description": "Describe pictures with a vision model: Docling's local one, or the service's configured one.",
     "title": "Picture Description",
     "type": "boolean"
    },
    "charts": {
     "default": false,
     "description": "Extract the data of charts.",
     "title": "Charts",
     "type": "boolean"
    },
    "images_scale": {
     "default": 1.0,
     "description": "Scale of the page images Docling renders.",
     "exclusiveMinimum": 0,
     "maximum": 4,
     "title": "Images Scale",
     "type": "number"
    },
    "engine": {
     "additionalProperties": true,
     "description": "Docling PdfPipelineOptions fields to set (merged over the named options), for example {\"table_structure_options\": {\"do_cell_matching\": false}}. Operational fields (paths, URLs, devices, batch sizes) are refused. See https://docling-project.github.io/docling/reference/pipeline_options/",
     "title": "Engine",
     "type": "object"
    }
   },
   "title": "Options",
   "type": "object"
  },
  "mineru": {
   "additionalProperties": false,
   "properties": {
    "tier": {
     "default": "standard",
     "description": "MinerU tier. Only PDFs and images support every tier; other formats are always parsed with flash.",
     "enum": [
      "flash",
      "basic",
      "standard",
      "advanced"
     ],
     "title": "Tier",
     "type": "string"
    },
    "ocr": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "auto",
       "type": "string"
      }
     ],
     "default": "auto",
     "description": "true forces OCR, false prefers the text layer (above flash, MinerU still OCRs regions without text), \"auto\" decides.",
     "title": "Ocr"
    },
    "image_analysis": {
     "default": false,
     "description": "Describe pictures with a vision model (MinerU's own default is true, which needs a VLM).",
     "title": "Image Analysis",
     "type": "boolean"
    },
    "page_range": {
     "anyOf": [
      {
       "items": {
        "minimum": 1,
        "type": "integer"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Parse only these pages: [first, last], 1-based and inclusive. PDF only; pages are numbered as in the file. Default: the whole file.",
     "title": "Page Range"
    }
   },
   "title": "Options",
   "type": "object"
  },
  "paddleocr": {
   "additionalProperties": false,
   "properties": {
    "tables": {
     "default": true,
     "description": "Table recognition.",
     "title": "Tables",
     "type": "boolean"
    },
    "formulas": {
     "default": true,
     "description": "Formula recognition.",
     "title": "Formulas",
     "type": "boolean"
    },
    "charts": {
     "default": false,
     "description": "Chart recognition.",
     "title": "Charts",
     "type": "boolean"
    },
    "seals": {
     "default": false,
     "description": "Seal recognition.",
     "title": "Seals",
     "type": "boolean"
    },
    "orientation": {
     "default": false,
     "description": "Document orientation classification.",
     "title": "Orientation",
     "type": "boolean"
    },
    "unwarp": {
     "default": false,
     "description": "Document unwarping.",
     "title": "Unwarp",
     "type": "boolean"
    },
    "heading_levels": {
     "default": false,
     "description": "Rank section titles with PaddleX's heading-level assignment (otherwise all are level 2).",
     "title": "Heading Levels",
     "type": "boolean"
    },
    "languages": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "maxItems": 1,
       "minItems": 1,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "OCR language, one PaddleOCR code (for example en, ch, japan, fr). Replaces PADDLEOCR_SHIM_LANG for this route; default: the service's setting.",
     "title": "Languages"
    },
    "ocr_version": {
     "anyOf": [
      {
       "enum": [
        "PP-OCRv3",
        "PP-OCRv4",
        "PP-OCRv5"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Text detection and recognition model generation. Default: PaddleOCR's own.",
     "title": "Ocr Version"
    },
    "textline_orientation": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Classify the orientation of each text line. Default: PP-StructureV3's own.",
     "title": "Textline Orientation"
    },
    "region_detection": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Detect document regions before layout analysis. Default: PP-StructureV3's own.",
     "title": "Region Detection"
    },
    "engine": {
     "additionalProperties": true,
     "description": "Other PPStructureV3 arguments (thresholds, model names, table switches), passed to its constructor and predict(). Model directories and batch sizes are refused. See https://www.paddleocr.ai/latest/en/version3.x/pipeline_usage/PP-StructureV3.html",
     "title": "Engine",
     "type": "object"
    }
   },
   "title": "Options",
   "type": "object"
  },
  "surya": {
   "additionalProperties": false,
   "properties": {
    "include_page_images": {
     "default": false,
     "description": "Return each rendered page as a base64 PNG.",
     "title": "Include Page Images",
     "type": "boolean"
    },
    "ocr_figures": {
     "default": false,
     "description": "Also read text inside pictures, figures and diagrams.",
     "title": "Ocr Figures",
     "type": "boolean"
    },
    "dpi": {
     "default": 192,
     "description": "Render resolution for PDF pages.",
     "maximum": 400,
     "minimum": 72,
     "title": "Dpi",
     "type": "integer"
    },
    "page_range": {
     "anyOf": [
      {
       "items": {
        "minimum": 1,
        "type": "integer"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Parse only these pages: [first, last], 1-based and inclusive. Pages are numbered as in the file. Default: the whole file.",
     "title": "Page Range"
    }
   },
   "title": "Options",
   "type": "object"
  },
  "bounds": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "gt": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "lt": {
     "type": "number",
     "exclusiveMaximum": 10
    },
    "whole": {
     "type": "integer",
     "minimum": 1.0,
     "maximum": 4.0
    },
    "name": {
     "type": "string",
     "minLength": 2,
     "maxLength": 4
    },
    "names": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "maxItems": 12
    },
    "either": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "choices": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "mode": {
     "enum": [
      "a",
      "b",
      null,
      3,
      true
     ],
     "type": [
      "string",
      "integer",
      "boolean",
      "null"
     ]
    },
    "fixed": {
     "const": 1.5
    }
   }
  },
  "required": {
   "type": "object",
   "required": [
    "a",
    "b",
    "c"
   ],
   "properties": {
    "a": {
     "type": "integer"
    },
    "b": {
     "type": "integer"
    },
    "c": {
     "type": "integer"
    }
   }
  },
  "nested": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "engine": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "beam": {
       "type": "integer",
       "minimum": 1
      },
      "inner": {
       "type": "object",
       "properties": {
        "x": {
         "type": "boolean"
        }
       }
      }
     }
    },
    "free": {
     "type": "object",
     "additionalProperties": {
      "type": "integer"
     }
    },
    "choice": {
     "anyOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "k": {
         "type": "integer"
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "need": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "k",
        "m"
       ],
       "properties": {
        "k": {
         "type": "integer"
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "deep": {
     "anyOf": [
      {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "const": "auto"
        }
       ]
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "refs": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "mode": {
     "$ref": "#/$defs/Mode"
    },
    "pair": {
     "anyOf": [
      {
       "$ref": "#/$defs/Pair"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "$defs": {
    "Mode": {
     "enum": [
      "x",
      "y"
     ],
     "type": "string"
    },
    "Pair": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    }
   }
  },
  "all_of": {
   "type": "object",
   "properties": {
    "n": {
     "allOf": [
      {
       "type": "integer"
      },
      {
       "minimum": 3
      },
      {
       "maximum": 5
      }
     ]
    }
   }
  }
 },
 "cases": [
